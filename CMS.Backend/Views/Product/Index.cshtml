@model IEnumerable<CMS.Data.Entities.Product>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý sản phẩm";
}


<div class="container mt-4">


    <!-- Header -->
    <div class="header-product">

        <div>
            <h2 class="text-danger fw-bold">
                <i class="bi bi-box-seam"></i>
                DANH SÁCH SẢN PHẨM
            </h2>

            <p class="text-muted">
                Quản lý sản phẩm đang kinh doanh
            </p>
        </div>


        <a asp-action="Create"
           class="btn btn-success px-4 shadow">

            <i class="bi bi-plus-circle"></i>
            Thêm sản phẩm mới

        </a>

    </div>




    <div class="product-list shadow-sm">


        <!-- Tên cột -->
        <div class="product-header">

            <div class="header-image">
                Ảnh
            </div>


            <div class="header-id">
                ID
            </div>


            <div class="header-name">
                Tên sản phẩm
            </div>


            <div class="header-category">
                Danh mục
            </div>


            <div class="header-price">
                Giá
            </div>


            <div class="header-description">
                Mô tả
            </div>


            <div class="header-action">
                Thao tác
            </div>


        </div>





        @foreach (var item in Model)
        {


            <div class="product-row">



                <div class="product-image">

                    <img src="@item.ImageUrl"
                         alt="Product">

                </div>




                <div class="product-id">

                    @item.Id

                </div>




                <div class="product-name">

                    <h5>
                        @item.Name
                    </h5>

                </div>


                <div class="product-category">

                    <span class="badge bg-info text-dark">

                        @(item.CategoryProduct != null
                                            ? item.CategoryProduct.Name
                                            : "Chưa phân loại")

                </span>

                </div>
                <div class="product-price">

                    @item.Price.ToString("N0") VNĐ

                </div>

                <div class="product-description">

                    @Html.Raw(item.Description)

                </div>

                <div class="product-action">


                    <a href="/Product/Details/@item.Id"
                       class="btn btn-outline-primary btn-sm">

                        <i class="bi bi-eye"></i>

                    </a>



                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-outline-warning btn-sm">

                        <i class="bi bi-pencil"></i>

                    </a>


                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-outline-danger btn-sm"
                       onclick="return confirm('Bạn chắc chắn có muốn xóa sản phẩm này không?')">

                        <i class="bi bi-trash"></i>

                    </a>
                </div>
            </div>
}
    </div>
    <div class="pagination-box mt-4">

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {

            <a asp-action="Index"
               asp-route-page="@i"
               class="page-btn @(ViewBag.CurrentPage == i ? "active" : "")">

                @i

            </a>

        }

    </div>
</div>





<style>


    .header-product {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }



    .product-list {
        background: white;
        border-radius: 15px;
        overflow: hidden;
    }



    /* HEADER CỘT */

    .product-header {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px 20px;
        background: #f1f3f5;
        border-bottom: 2px solid #dee2e6;
        font-weight: bold;
        color: #495057;
    }




    .header-image {
        width: 90px;
        text-align: center;
    }


    .header-id {
        width: 60px;
    }


    .header-name {
        width: 180px;
    }


    .header-category {
        width: 140px;
    }


    .header-price {
        width: 140px;
    }


    .header-description {
        width: 250px;
    }


    .header-action {
        margin-left: auto;
        width: 120px;
        text-align: center;
    }





    /* ROW */


    .product-row {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px 20px;
        border-bottom: 1px solid #eee;
        transition: .3s;
    }



        .product-row:hover {
            background: #f8f9fa;
        }




    .product-image {
        width: 90px;
        height: 80px;
        background: #f5f5f5;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
    }





        .product-image img {
            width: 75px;
            height: 75px;
            object-fit: contain;
        }





    .product-id {
        width: 60px;
        font-weight: bold;
        color: #6c757d;
        flex-shrink: 0;
    }





    .product-name {
        width: 180px;
        overflow: hidden;
        flex-shrink: 0;
    }



        .product-name h5 {
            margin: 0;
            color: #0d6efd;
            font-size: 16px;
            word-break: break-word;
        }





    .product-category {
        width: 140px;
        overflow: hidden;
        flex-shrink: 0;
    }

        .product-category .badge {
            display: inline-block;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }





    .product-price {
        width: 140px;
        color: #dc3545;
        font-weight: bold;
        flex-shrink: 0;
        white-space: nowrap;
    }





    .product-description {
        width: 250px;
        color: #6c757d;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex-shrink: 0;
    }





    .product-action {
        display: flex;
        gap: 8px;
        margin-left: auto;
    }




        .product-action .btn {
            border-radius: 8px;
        }
    /* =========================
       PHÂN TRANG SẢN PHẨM
    ========================= */


    .pagination-box {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        margin-top: 25px;
        margin-bottom: 30px;
    }



    /* nút số trang */

    .page-btn {
        width: 42px;
        height: 42px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 12px;
        background: white;
        border: 1px solid #dee2e6;
        color: #495057;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 3px 8px rgba(0,0,0,0.08);
        transition: .3s;
    }




        /* rê chuột */

        .page-btn:hover {
            background: #0d6efd;
            color: white;
            border-color: #0d6efd;
            transform: translateY(-3px);
        }




        /* trang đang chọn */

        .page-btn.active {
            background: #dc3545;
            color: white;
            border-color: #dc3545;
            box-shadow: 0 4px 12px rgba(220,53,69,.35);
        }
</style>