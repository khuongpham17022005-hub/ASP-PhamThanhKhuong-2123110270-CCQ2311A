@model IEnumerable<CMS.Data.Entities.Post>


@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý bài viết";
}



<div class="container mt-4">



    <!-- HEADER -->

    <div class="header-post-page">



        <div>


            <h2 class="text-danger fw-bold">

                <i class="bi bi-newspaper"></i>

                DANH SÁCH BÀI VIẾT

            </h2>


            <p class="text-muted">

                Quản lý các bài viết trong hệ thống

            </p>


        </div>





        <a asp-action="Create"
           class="btn btn-success px-4 shadow">


            <i class="bi bi-plus-circle"></i>

            Thêm bài viết mới


        </a>



    </div>






    <div class="post-list shadow-sm">





        <!-- HEADER COLUMN -->


        <div class="post-header">



            <div class="header-image">
                Ảnh
            </div>



            <div class="header-id">
                ID
            </div>




            <div class="header-title">
                Tiêu đề
            </div>





            <div class="header-category">
                Danh mục
            </div>





            <div class="header-content">
                Nội dung
            </div>





            <div class="header-date">
                Ngày đăng
            </div>





            <div class="header-action">
                Thao tác
            </div>



        </div>








        @foreach (var item in Model)
        {



            <div class="post-row">






                <div class="post-image">


                    <img src="@item.ImageUrl"
                         alt="Post">


                </div>







                <div class="post-id">

                    @item.Id

                </div>







                <div class="post-title">


                    <h5>

                        @item.Title


                    </h5>


                </div>







                <div class="post-category">


                    <span class="badge bg-info text-dark">


                        @(item.Category != null
                                            ? item.Category.Name
                                            : "Chưa phân loại")


                </span>


                </div>









                <div class="post-content">


                    @Html.Raw(item.Content)


                </div>








                <div class="post-date">


                    <span>

                        @item.CreatedDate.ToString("dd/MM/yyyy")

                    </span>


                </div>







                <div class="post-action">





                    <a href="/Post/Details/@item.Id"
                       class="btn btn-outline-primary btn-sm">


                        <i class="bi bi-eye"></i>


                    </a>






                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-outline-warning btn-sm">


                        <i class="bi bi-pencil"></i>


                    </a>







                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-outline-danger btn-sm"
                       onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này?')">


                        <i class="bi bi-trash"></i>


                    </a>





                </div>





            </div>


                }





    </div>


</div>







<style>


    .header-post-page {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }





    .post-list {
        background: white;
        border-radius: 15px;
        overflow: hidden;
    }






    .post-header {
        display: flex;
        align-items: center;
        padding: 15px 20px;
        background: #f1f3f5;
        border-bottom: 2px solid #dee2e6;
        font-weight: bold;
        color: #495057;
    }







    .header-image,
    .post-image {
        width: 90px;
    }






    .header-id,
    .post-id {
        width: 60px;
    }






    .header-title,
    .post-title {
        width: 220px;
    }






    .header-category,
    .post-category {
        width: 140px;
    }






    .header-content,
    .post-content {
        width: 260px;
    }







    .header-date,
    .post-date {
        width: 120px;
    }








    .header-action {
        margin-left: auto;
        width: 120px;
        text-align: center;
    }









    .post-row {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px 20px;
        border-bottom: 1px solid #eee;
        transition: .3s;
    }






        .post-row:hover {
            background: #f8f9fa;
        }








    .post-image {
        height: 80px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #f5f5f5;
        border-radius: 12px;
    }







        .post-image img {
            width: 75px;
            height: 75px;
            object-fit: cover;
            border-radius: 10px;
        }









    .post-id {
        font-weight: bold;
        color: #6c757d;
    }








    .post-title h5 {
        margin: 0;
        color: #0d6efd;
        font-size: 16px;
    }








    .post-content {
        color: #6c757d;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }









    .post-date {
        color: #dc3545;
        font-weight: bold;
    }









    .post-action {
        margin-left: auto;
        display: flex;
        gap: 8px;
    }







        .post-action .btn {
            width: 38px;
            height: 32px;
            border-radius: 8px;
        }
</style>